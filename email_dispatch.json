  "corpo_html": "<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<body style=\"margin:0;padding:20px;background-color:#F4EFE6;font-family:'Segoe UI',Arial,sans-serif;color:#2C2B28;\">\n  <div style=\"max-width:740px;margin:0 auto;background:#F4EFE6;\">\n    <div style=\"background:#FFFCF6;border:1px solid #CDB892;border-bottom:3px solid #1F3A5F;border-radius:10px;padding:18px 22px;margin-bottom:16px;\">\n      <div style=\"font-size:11px;font-weight:bold;letter-spacing:1.5px;color:#8A7350;text-transform:uppercase;\">DECON · Diretoria de Assuntos Econômicos · MPOR</div>\n      <h1 style=\"margin:4px 0 8px 0;font-size:21px;color:#1F3A5F;\">Clipping Diário Executivo — 28/10/2026</h1>\n      <div style=\"margin-top:12px;\">\n        <a href=\"https://mdagavea.github.io/inteligencia-regulatoria/clipping.html\" style=\"display:inline-block;background:#1F3A5F;color:#FFF8EC;text-decoration:none;font-size:13px;font-weight:bold;padding:9px 18px;border-radius:20px;margin-right:8px;\">👉 Abrir Painel Completo & Radares Complementares ↗</a>\n        <a href=\"https://mdagavea.github.io/inteligencia-regulatoria/historico/index.html\" style=\"display:inline-block;background:#F4EFE6;color:#1F3A5F;border:1px solid #CDB892;text-decoration:none;font-size:12px;font-weight:bold;padding:8px 14px;border-radius:20px;\">📚 Acervo de Edições</a>\n      </div>\n    </div>\n    \n        <div style=\"background:#FFFCF6;border:1px solid #E2D5BE;border-top:4px solid #1F3A5F;border-radius:8px;padding:14px 18px;margin-bottom:14px;\">\n          <h3 style=\"margin:0 0 12px 0;font-size:15px;color:#1F3A5F;\">⚓ Infraestrutura & Outorgas <span style=\"font-size:11px;color:#6B6457;font-weight:normal;\">(+5 no radar web)</span></h3>\n          \n            <div style=\"margin-bottom:12px;padding-left:10px;border-left:3px solid #1F3A5F;\">\n              <div style=\"font-size:11px;font-weight:bold;color:#6B6457;margin-bottom:2px;\">[Agência iNFRA] • Leilões, Editais & PPI</div>\n              <a href=\"https://agenciainfra.com/blog/aneel-aprova-editais-dos-leiloes-de-baterias-marcados-para-dezembro/?utm_source=rss&utm_medium=rss&utm_campaign=aneel-aprova-editais-dos-leiloes-de-baterias-marcados-para-dezembro\" style=\"font-size:14px;font-weight:bold;color:#1F3A5F;text-decoration:none;\">ANEEL aprova editais dos leilões de baterias, marcados para dezembro</a>\n              <div style=\"font-size:13px;color:#3B3A36;margin-top:3px;line-height:1.4;\">A ANEEL aprovou os editais para os leilões de armazenamento de energia, previstos para o início de dezembro, com foco em garantir segurança ao sistema elétrico.</div>\n            </div>\n            <div style=\"margin-bottom:12px;padding-left:10px;border-left:3px solid #1F3A5F;\">\n              <div style=\"font-size:11px;font-weight:bold;color:#6B6457;margin-bottom:2px;\">[Agência iNFRA] • Leilões, Editais & PPI</div>\n              <a href=\"https://agenciainfra.com/blog/mpor-preve-34-novos-leiloes-portuarios-com-ate-r-23-bi-em-investimentos/?utm_source=rss&utm_medium=rss&utm_campaign=mpor-preve-34-novos-leiloes-portuarios-com-ate-r-23-bi-em-investimentos\" style=\"font-size:14px;font-weight:bold;color:#1F3A5F;text-decoration:none;\">MPor prevê 34 novos leilões portuários com até R$ 23 bi em investimentos</a>\n              <div style=\"font-size:13px;color:#3B3A36;margin-top:3px;line-height:1.4;\">O Ministério de Portos e Aeroportos anunciou uma carteira robusta de 34 leilões portuários, visando atrair R$ 23 bilhões em investimentos privados.</div>\n            </div>\n            <div style=\"margin-bottom:12px;padding-left:10px;border-left:3px solid #1F3A5F;\">\n              <div style=\"font-size:11px;font-weight:bold;color:#6B6457;margin-bottom:2px;\">[DatamarNews] • Regulação & Contratos (ANTT / ANAC / ANTAQ / Portos)</div>\n              <a href=\"https://news.google.com/rss/articles/CBMiygFBVV95cUxOeURoaG9jVlZZZ2NzOVo4dThMWGRKZmljMzhCaDhPVUZSVEJGU2VwSldlWGdyblNqRlpZZXk1YTlCa3ZwWkxpWFBZZ242Vko4U3lHTGtCaEc3aVZ0d2pxQVRF